@model CommUnityHub.Models.Offer

@{
    ViewData["Title"] = "Delete Offer";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="card shadow-sm border-danger">
                <div class="card-body">
                    <h2 class="card-title text-danger">Delete Offer</h2>
                    <p class="text-muted">Are you sure you want to delete this offer? This action cannot be undone.</p>

                    <div class="mb-3">
                        <strong>Title:</strong> @Model.Title
                    </div>

                    <div class="mb-3">
                        <strong>Category:</strong> @Model.Category
                    </div>

                    <div class="mb-3">
                        <strong>Location:</strong> @Model.Location
                    </div>

                    <div class="mb-4">
                        <strong>Status:</strong> @Model.Status
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="OfferId" />

                        <button type="submit" class="btn btn-danger">Delete</button>
                        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
