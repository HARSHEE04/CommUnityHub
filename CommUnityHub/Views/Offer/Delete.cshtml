@model CommUnityHub.Models.Offer

@{
    ViewData["Title"] = "Delete Offer";
}

<div class="py-5 text-center" style="background: linear-gradient(90.4deg, rgb(255, 220, 163) 21.2%, rgb(129, 255, 239) 90.7%);">
    <div class="container">
        <h1 class="fw-bold text-danger">Delete Offer</h1>
        <p class="text-dark mx-auto" style="max-width:700px;">
            Confirm deletion of this offer. This action cannot be undone.
        </p>
    </div>
</div>

<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-md-9">
            <div class="card shadow-sm rounded-4 border border-danger">
                <div class="card-body">
                    <div class="mb-3"><strong>Title:</strong> @Model.Title</div>
                    <div class="mb-3"><strong>Category:</strong> @Model.Category</div>
                    <div class="mb-3"><strong>Location:</strong> @Model.Location</div>
                    <div class="mb-4"><strong>Status:</strong> @Model.Status</div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="OfferId" />
                        <button type="submit" class="btn btn-danger">Delete</button>
                        <a asp-action="Index" class="btn btn-outline-secondary ms-2">Cancel</a>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
