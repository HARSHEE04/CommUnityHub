@model IEnumerable<CommUnityHub.Models.Offer>

@{
    ViewData["Title"] = "Offer Listing";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Offer Listing</h2>
        <a asp-controller="Offer" asp-action="Create" class="btn btn-success">
            + Create New Offer
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-info">
            There are no approved offers yet. Be the first to post one!
        </div>
    }
    else
    {
        <div class="card">
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th style="width: 160px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var offer in Model)
                        {
                            <tr>
                                <td>@offer.Title</td>
                                <td>@offer.Category</td>
                                <td>@offer.Location</td>
                                <td>@offer.Status</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@offer.OfferId"
                                       class="btn btn-sm btn-outline-warning me-1">Edit</a>
                                    <a asp-action="Delete" asp-route-id="@offer.OfferId"
                                       class="btn btn-sm btn-outline-danger">Delete</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
