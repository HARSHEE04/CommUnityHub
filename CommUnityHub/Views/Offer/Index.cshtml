@model IEnumerable<CommUnityHub.Models.Offer>

@{
    ViewData["Title"] = "Offer Listing";
}

<div class="py-5 text-center" style="background: linear-gradient(90.4deg, rgb(255,220,163) 21.2%, rgb(129,255,239) 90.7%);">
    <div class="container">
        <h1 class="fw-bold text-primary">Offer Listing</h1>
        <p class="text-dark mx-auto" style="max-width:700px;">
            Explore all approved community offers. Share your skills or resources to help others.
        </p>
    </div>
</div>

<div class="container my-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3 class="fw-semibold">Community Offers</h3>

        @* Checking if user is Admin OR Volunteer *@
        @if (User.IsInRole("Volunteer") || User.IsInRole("Admin"))
        {
            <a asp-controller="Offer" asp-action="Create" class="btn btn-success shadow-sm">
                + Create New Offer
            </a>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-warning">
            There are no approved offers yet. Be the first to post one!
        </div>
    }
    else
    {
        <div class="card shadow-sm rounded-4 border-0">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Location</th>
                            <th>Status</th>

                            @* Conditionally display the Actions column header *@
                            @if (User.IsInRole("Volunteer") || User.IsInRole("Admin"))
                            {
                                <th style="width: 160px;">Actions</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var offer in Model)
                        {
                            <tr>
                                <td>@offer.Title</td>
                                <td>@offer.Category</td>
                                <td>@offer.Location</td>
                                <td>@offer.Status</td>

                                @* Conditionally display the Edit/Delete buttons cell *@
                                @if (User.IsInRole("Volunteer") || User.IsInRole("Admin"))
                                {
                                    <td>
                                        <a asp-action="Edit" asp-route-id="@offer.OfferId"
                                           class="btn btn-sm btn-outline-warning me-1">Edit</a>
                                        <a asp-action="Delete" asp-route-id="@offer.OfferId"
                                           class="btn btn-sm btn-outline-danger">Delete</a>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>