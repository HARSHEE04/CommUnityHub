@model IEnumerable<CommUnityHub.Models.Offer>

@{
    ViewData["Title"] = "Pending Offers";
}

<div class="container mt-4">
    <h2>Pending Offers (Admin Review)</h2>
    <p class="text-muted">Approve or reject offers submitted by community members.</p>

    @if (!Model.Any())
    {
        <div class="alert alert-info mt-3">
            There are no pending offers to review.
        </div>
    }
    else
    {
        <div class="card shadow-sm mt-3">
            <div class="card-body p-0">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Title</th>
                            <th>Category</th>
                            <th>Location</th>
                            <th>Status</th>
                            <th style="width: 180px;"></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var offer in Model)
                        {
                            <tr>
                                <td>@offer.Title</td>
                                <td>@offer.Category</td>
                                <td>@offer.Location</td>
                                <td>@offer.Status</td>
                                <td>
                                    <form asp-action="Approve" asp-route-id="@offer.OfferId" method="post" style="display:inline">
                                        <button type="submit" class="btn btn-sm btn-success me-1">Approve</button>
                                    </form>

                                    <form asp-action="Reject" asp-route-id="@offer.OfferId" method="post" style="display:inline">
                                        <button type="submit" class="btn btn-sm btn-warning">Reject</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>
