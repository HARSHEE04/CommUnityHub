@model List<CommUnityHub.Models.User>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<!-- Hero Header -->
<div class="py-5 text-center"
     style="background: linear-gradient(90.4deg, rgb(255, 220, 163) 21.2%, rgb(129, 255, 239) 90.7%);
            border-bottom: 4px solid #e4c349;">
    <div class="container">
        <h1 class="fw-bold text-primary mb-3">Admin Dashboard</h1>
        <p class="text-dark mx-auto" style="max-width: 800px;">
            Validate users, manage volunteers, and oversee the community platform.
        </p>
    </div>
</div>

<!-- Main Content -->
<div class="container mt-5">

    @if (Model == null || !Model.Any())
    {
        <!-- Empty State -->
        <div class="text-center p-5">
            <i class="bi bi-person-x fs-1 text-secondary"></i>
            <h4 class="text-muted mt-3">No Users Found</h4>
            <p class="text-secondary">
                There are no new users to validate at this time.
            </p>
        </div>
    }
    else
    {
        <!-- User Cards -->
        <div class="row gy-4 gx-3">

            @foreach (var user in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card shadow-sm border-0 rounded-4 h-100"
                         style="transition: 0.2s; border-left: 5px solid #ffd27f;">
                        <div class="card-body d-flex flex-column p-4">

                            <h4 class="fw-bold text-primary mb-2">@user.FullName</h4>

                            <p class="text-muted mb-1">
                                <strong>Email:</strong> @user.Email
                            </p>

                            <p class="text-muted mb-3">
                                <strong>Status:</strong>
                                @(user.IsVerified ? "Verified" : "Pending")
                            </p>

                            @if (!user.IsVerified)
                            {
                                <form asp-action="ValidateUser" method="post" class="mt-auto">
                                    <input type="hidden" name="userId" value="@user.Id" />

                                    <button type="submit"
                                            class="btn btn-success w-100 rounded-3 fw-semibold">
                                        <i class="bi bi-check-circle me-2"></i> Validate
                                    </button>
                                </form>
                            }
                            else
                            {
                                <div class="mt-auto text-center">
                                    <span class="badge bg-success px-3 py-2 rounded-pill">
                                        Verified
                                    </span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }

        </div>
    }
</div>
