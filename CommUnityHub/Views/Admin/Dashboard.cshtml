@model List<CommUnityHub.Models.User>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<div class="py-5 resource-header" style="border-bottom: 4px solid #e4c349;">
    <div class="container text-center">
        <h1 class="fw-bold mb-3 resource-title">Admin Dashboard</h1>
        <p class="text-secondary mx-auto resource-desc">
            Validate users, manage volunteers, and oversee the community platform.
        </p>
    </div>
</div>

<div class="container mt-5">
    @if (Model == null || !Model.Any())
    {
        <div class="empty-state">
            <i class="bi bi-person-x"></i>
            <h4 class="text-muted">No Users Found</h4>
            <p class="text-secondary">No new users to validate at this time.</p>
        </div>
    }
    else
    {
        <div class="row gy-4 gx-3">
            @foreach (var user in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card shadow-sm resource-card">
                        <div class="card-body d-flex flex-column">
                            <h4 class="fw-bold mb-2">@user.FullName</h4>
                            <p class="text-muted mb-1"><strong>Email:</strong> @user.Email</p>
                            <p class="text-muted mb-2">
                                <strong>Status:</strong> @(user.IsVerified ? "Verified" : "Pending")
                            </p>
                            @if (!user.IsVerified)
                            {
                                <form asp-action="ValidateUser" method="post" class="mt-auto">
                                    <input type="hidden" name="userId" value="@user.Id" />
                                    <button type="submit" class="btn-core btn-green w-100">
                                        <i class="bi bi-check-circle me-2"></i> Validate
                                    </button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
