@model CommUnityHub.Models.Resource

@{
    ViewData["Title"] = "Resource Details";
}

<!-- Hero / Header -->
<div class="py-5 text-center" style="background: radial-gradient(circle at 10% 20%, rgb(253, 239, 132) 0%, rgb(247, 198, 169) 54.2%, rgb(21, 186, 196) 100.3%);">
    <div class="container">
        <h1 class="fw-bold mb-2 text-primary">Resource Details</h1>
        <p class="text-dark mx-auto" style="max-width:800px;">
            Comprehensive information about <span class="fw-semibold text-success">@Model.Name</span>
        </p>
    </div>
</div>

<div class="container my-5">
    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body">

            <!-- Title + quick meta -->
            <h3 class="fw-bold text-primary mb-3"><i class="bi bi-info-circle me-2 text-success"></i>@Model.Name</h3>

            <div class="d-flex flex-wrap gap-3 mb-3">
                @if (!string.IsNullOrEmpty(Model.Category))
                {
                    <div class="badge bg-light text-primary px-3 py-2">
                        <strong>Category:</strong> @Model.Category
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Region))
                {
                    <div class="badge bg-light text-success px-3 py-2">
                        <strong>Region:</strong> @Model.Region
                    </div>
                }
                <div class="badge bg-light text-secondary px-3 py-2">
                    <strong>Address:</strong> Use maps to get directions
                </div>
            </div>

            <hr />

            <!-- Phone -->
            @{
                var cleanPhone = (Model.Phone ?? "").Trim();
            }
            @if (!string.IsNullOrWhiteSpace(cleanPhone))
            {
                <div class="mb-3">
                    <h6 class="fw-semibold text-primary">Phone</h6>
                    <div class="text-dark">
                        @foreach (var line in cleanPhone.Split(new[] { "<br>", "<br/>", "\n", "\r" }, StringSplitOptions.RemoveEmptyEntries))
                        {
                            <div>@Html.Raw(line)</div>
                        }
                    </div>
                </div>
            }

            <!-- Hours of operation -->
            @{
                var plainHours = System.Text.RegularExpressions.Regex.Replace(Model.HoursOfOperation ?? "", "<.*?>", "").Trim();
            }
            @if (!string.IsNullOrWhiteSpace(plainHours))
            {
                <div class="mb-3">
                    <h6 class="fw-semibold text-primary">Hours of Operation</h6>
                    <div class="text-dark">@Html.Raw(Model.HoursOfOperation)</div>
                </div>
            }

            <hr />

            <!-- Map -->
            <h6 class="fw-semibold text-success mb-2"><i class="bi bi-geo-alt-fill me-1"></i>Location on Map</h6>

            @if (ViewBag.MapsUrl != null)
            {
                <iframe class="w-100 rounded-3 border-0" height="350" loading="lazy" allowfullscreen referrerpolicy="no-referrer-when-downgrade" src="@ViewBag.MapsUrl"></iframe>
            }
            else
            {
                <div class="alert alert-warning d-flex align-items-center mt-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>
                    Map could not be loaded for this resource.
                </div>
            }

            <!-- Back button -->
            <a href="/Resources/loadDashboard" class="btn btn-primary mt-4">
                <i class="bi bi-arrow-left me-2"></i> Back to Resources
            </a>

        </div>
    </div>
</div>
