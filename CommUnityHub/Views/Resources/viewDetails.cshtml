@model CommUnityHub.Models.Resource

@{
    ViewData["Title"] = "Resource Details";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"]</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link href="https://fonts.googleapis.com/css2?family=Roboto:wght@400;700&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <style>
        body {
            font-family: 'Roboto', Arial, sans-serif;
            font-size: 1.06rem;
            background: #f8fafb;
            color: #1a1a1a;
        }

        .container {
            max-width: 820px;
            margin: 0 auto;
        }

        .details-header {
            background: linear-gradient(98deg, #e8f5e9 60%, #f5f5f5 100%);
            border-bottom: 4px solid #e4c349;
            box-shadow: 0 2px 18px rgba(38,86,66,0.08);
            padding: 2.5rem 0 1.6rem 0;
            text-align: center;
            margin-bottom: 32px;
        }

        .details-title {
            font-size: 2.5rem;
            color: #1f6c3f;
            font-weight: 700;
            letter-spacing: -0.5px;
            margin-bottom: .9rem;
        }

        .details-subtitle {
            font-size: 1.2rem;
            color: #656565;
            font-weight: 400;
            margin-bottom: .5rem;
        }

        .card {
            border-radius: 18px !important;
            box-shadow: 0 6px 32px rgba(28,48,26,.10);
            background: #fff;
            padding: 2.2rem 2.2rem;
            margin-bottom: 32px;
        }

        .card-title {
            color: #249c6b;
            font-weight: bold;
            font-size: 2rem;
            letter-spacing: 0.01em;
            margin-bottom: 18px;
        }

        .card-text strong {
            color: #347764;
            font-weight: 600;
        }

        .card hr {
            margin: 2.2rem 0;
        }

        .info-row {
            display: flex;
            flex-wrap: wrap;
            gap: 2.2rem .85rem;
        }

        .info-box {
            margin-bottom: .45rem;
        }

        .alert-warning {
            border-radius: 10px;
            font-size: .98em;
            color: #336b1f;
            background: #fffbe4;
        }

        .btn-secondary {
            background: #b2b2b2;
            border-radius: 10px;
            font-weight: 600;
            padding: 12px 32px;
            font-size: 1.08em;
            border: none;
            transition: background .18s, box-shadow .18s;
            box-shadow: 0 2px 8px rgba(38,86,66,0.04);
            color: #fff;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

            .btn-secondary:hover {
                background: #787878;
                color: #efefef;
                box-shadow: 0 5px 20px rgba(38,86,66,0.11);
                text-decoration: none;
            }

        iframe {
            border-radius: 14px;
            min-height: 326px;
        }
        @@media (max-width:991px) {
            .container

        {
            max-width: 98vw;
            padding-left: 12px;
            padding-right: 12px;
        }

        .details-title {
            font-size: 2.1rem;
        }

        .card {
            padding: 1.2rem .5rem;
        }

        }
        @@media (max-width: 767px) {
            .details-title

        {
            font-size: 1.7rem;
        }

        .details-subtitle {
            font-size: 1.02rem;
        }

        .card {
            padding: 0.9rem .3rem;
        }

        iframe {
            min-height: 210px;
        }

        .btn-secondary {
            padding: 10px 19px;
            font-size: .98em;
        }

        }
    </style>
</head>
<body>
    <div class="details-header">
        <div class="container">
            <div class="details-title"><i class="bi bi-info-circle"></i> Resource Details</div>
            <div class="details-subtitle">Comprehensive information about <span style="color:#249c6b; font-weight:600;">@Model.Name</span></div>
        </div>
    </div>

    <div class="container">
        <div class="card shadow-sm resource-detail-card">
            <div class="card-body">
                <!-- Resource name -->
                <h3 class="card-title mb-2"><i class="bi bi-dot"></i> @Model.Name</h3>
                <div class="card-text mb-3">
                    <div class="info-row">
                        <div class="info-box">
                            <strong>Category:</strong> @Model.Category
                        </div>
                        <div class="info-box">
                            <strong>Region:</strong> @Model.Region
                        </div>
                        <div class="info-box">
                            <strong>Latitude & Longitude:</strong> @Model.Address
                        </div>
                    </div>
                </div>
                @* Phone number *@
                @{
                    var cleanPhone = (Model.Phone ?? "").Trim();
                }
                @if (!string.IsNullOrWhiteSpace(cleanPhone))
                {
                    <div class="info-box mb-2">
                        <strong>Phone:</strong><br />
                        @foreach (var line in cleanPhone.Split(
                                            new[] { "<br>", "<br/>", "\n", "\r" },
                                            StringSplitOptions.RemoveEmptyEntries))
                        {
                            <span style="display:inline-block;margin-bottom:5px;">@Html.Raw(line)</span>
                        }
                    </div>
                }
                @{
                    var plainHours = System.Text.RegularExpressions.Regex
                    .Replace(Model.HoursOfOperation ?? "", "<.*?>", "")
                    .Trim();
                }
                @if (!string.IsNullOrWhiteSpace(plainHours))
                {
                    <div class="info-box mb-2">
                        <strong>Hours of Operation:</strong><br />
                        <span>@Html.Raw(Model.HoursOfOperation)</span>
                    </div>
                }
                <hr />
                <h4 class="mt-2 mb-3" style="color:#1f6c3f;"><i class="bi bi-geo-alt-fill me-1"></i> Location on Map</h4>
                @if (ViewBag.MapsUrl != null)
                {
                    <iframe width="100%"
                            height="350"
                            loading="lazy"
                            allowfullscreen
                            referrerpolicy="no-referrer-when-downgrade"
                            src="@ViewBag.MapsUrl">
                    </iframe>
                }
                else
                {
                    <div class="alert alert-warning mt-3">
                        <i class="bi bi-exclamation-triangle"></i> Map could not be loaded for this resource.
                    </div>
                }
                <!-- Back Button -->
                <a href="/Resources/loadDashboard" class="btn btn-secondary mt-4">
                    <i class="bi bi-arrow-left"></i> Back to Resources
                </a>
            </div>
        </div>
    </div>
</body>
</html>
