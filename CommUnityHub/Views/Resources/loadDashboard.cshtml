@model List<CommUnityHub.Models.Resource>

@{
    ViewData["Title"] = "Resources";
    string keyword = ViewBag.SearchTerm;
    string region = ViewBag.SelectedRegion;
    bool? sortAscending = ViewBag.SortAscending;
}

<!-- Hero / Header -->
<div class="py-5 text-center" style="background: radial-gradient(circle at 10% 20%, rgb(253, 239, 132) 0%, rgb(247, 198, 169) 54.2%, rgb(21, 186, 196) 100.3%);">
    <div class="container">
        <h1 class="fw-bold mb-3 text-primary">Resource Hub</h1>
        <p class="text-dark mx-auto" style="max-width: 800px;">
            The CommUnity Hub is your central platform for discovering local services, support programs,
            and community-focused resources. Explore tools, information, and insights designed to
            strengthen the well-being of children, youth, and families in our region.
        </p>
    </div>
</div>

<!-- Search, Filter, Sort -->
<div class="container mt-5">
    <div class="card shadow-sm border-0 bg-white">
        <div class="card-body py-4">
            <div class="row g-4">

                <!-- Search -->
                <div class="col-lg-4 col-md-12">
                    <form method="get" action="/Resources/Search" class="d-flex gap-2">
                        <div class="input-group rounded-3">
                            <!-- Search symbol: White text on blue background (Good contrast) -->
                            <span class="input-group-text bg-primary text-white border-primary rounded-start-3">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" name="keyword" class="form-control" placeholder="Search resources..." value="@ViewBag.SearchTerm">
                        </div>
                        <button class="btn btn-primary rounded-3" type="submit">
                            <i class="bi bi-arrow-right"></i>
                        </button>
                    </form>
                </div>

                <!-- Filter by Region -->
                <div class="col-lg-4 col-md-12">
                    <form method="get" action="/Resources/FilterByRegion" class="d-flex gap-2">
                        <div class="input-group rounded-3">
                            <!-- FIX: Changed text-white to text-dark for better visibility on yellow (bg-warning) -->
                            <span class="input-group-text bg-warning text-dark border-warning rounded-start-3">
                                <i class="bi bi-geo-alt-fill"></i>
                            </span>
                            <select name="region" class="form-select">
                                <option value="">All Regions</option>
                                <option value="Peel" @(region == "Peel" ? "selected" : "")>Peel</option>
                                <option value="Halton" @(region == "Halton" ? "selected" : "")>Halton</option>
                                <option value="Toronto" @(region == "Toronto" ? "selected" : "")>Toronto</option>
                                <option value="York" @(region == "York" ? "selected" : "")>York</option>
                                <option value="Durham" @(region == "Durham" ? "selected" : "")>Durham</option>
                            </select>
                        </div>
                        <button class="btn btn-warning text-white rounded-3" type="submit">
                            <i class="bi bi-funnel"></i>
                        </button>
                    </form>
                </div>

                <!-- Sort -->
                <div class="col-lg-4 col-md-12 d-flex align-items-center gap-2">
                    <a class="btn btn-outline-primary @(sortAscending == true ? "active" : "")"
                       href="@Url.Action("SortResources", "Resources", new { ascending = true })">
                        <i class="bi bi-sort-alpha-down"></i> A–Z
                    </a>
                    <a class="btn btn-outline-primary @(sortAscending == false ? "active" : "")"
                       href="@Url.Action("SortResources", "Resources", new { ascending = false })">
                        <i class="bi bi-sort-alpha-up"></i> Z–A
                    </a>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Active filters -->
@if (!string.IsNullOrEmpty(keyword) || !string.IsNullOrEmpty(region))
{
    <div class="container mt-3">
        <span class="text-dark fw-semibold me-2">Active filters:</span>
        @if (!string.IsNullOrEmpty(keyword))
        {
            <span class="badge bg-primary me-2">
                <i class="bi bi-search me-1"></i> "@keyword"
                <a href="@Url.Action("loadDashboard", "Resources")" class="text-white text-decoration-none ms-2">&times;</a>
            </span>
        }
        @if (!string.IsNullOrEmpty(region))
        {
            <!-- Updated to use text-dark for visibility -->
            <span class="badge bg-warning text-dark me-2">
                <i class="bi bi-geo-alt me-1"></i> @region
                <a href="@Url.Action("loadDashboard", "Resources")" class="text-dark text-decoration-none ms-2">&times;</a>
            </span>
        }
    </div>
}

<!-- Resources List -->
<div class="container mt-5">
    @if (Model == null || !Model.Any())
    {
        <div class="text-center p-5 bg-white rounded shadow-sm">
            <i class="bi bi-inbox display-4 mb-3 text-muted"></i>
            <h4 class="text-muted">No Resources Found</h4>
            <p class="text-secondary">Try adjusting your search or filter criteria.</p>
        </div>
    }
    else
    {
        <p class="text-dark"><i class="bi bi-list-ul me-1"></i> Showing <strong>@Model.Count()</strong> resource(s)</p>

        <div class="row g-4">
            @foreach (var r in Model)
            {
                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 border-0 shadow-sm bg-white">
                        <div class="card-body d-flex flex-column">
                            <h4 class="fw-bold text-primary">@r.Name</h4>
                            <p class="text-dark mb-1"><strong>Category:</strong> @r.Category</p>
                            <p class="text-dark small"><i class="bi bi-geo-alt-fill text-warning me-2"></i> @r.Region</p>
                            <a href="@Url.Action("viewDetails", "Resources", new { id = r.Id })" class="btn btn-primary mt-auto">
                                <i class="bi bi-arrow-right-circle me-2"></i> View Details
                            </a>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>