@model List<CommUnityHub.Models.Resource>

@{
    ViewData["Title"] = "Resources";
}

<h1 class="mb-4">Community Resources</h1>


<div class="row mb-4">

    <!-- Search bar -->
    <div class="col-md-4">
        <form method="get" action="/Resources/Search">
            <div class="input-group">
                <input type="text"
                       name="keyword"
                       class="form-control"
                       placeholder="Search resources..."
                       value="@ViewBag.SearchTerm" />

                <button class="btn btn-primary" type="submit">Search</button>
            </div>
        </form>
    </div>

    <!-- Region filter -->
    <div class="col-md-4">
        <form method="get" action="/Resources/FilterByRegion">
            <div class="input-group">
                <select name="region" class="form-select">
                    <option value="">Filter by Region</option>
                    <option value="Peel">Peel</option>
                    <option value="Halton">Halton</option>
                    <option value="Toronto">Toronto</option>
                    <option value="York">York</option>
                    <option value="Durham">Durham</option>
                </select>

                <button class="btn btn-secondary" type="submit">Filter</button>
            </div>
        </form>
    </div>

    <!-- Sorting -->
    <div class="col-md-4 text-end">
        <a class="btn btn-outline-dark me-2"
            href="@Url.Action("SortResources", "Resources", new { ascending = true })">Sort A–Z</a>

        <a class="btn btn-outline-dark"
           href="@Url.Action("SortResources", "Resources", new { ascending = false })">Sort Z–A</a>

    </div>
</div>


@if (Model == null || !Model.Any())
{
    <div class="alert alert-info mt-4">
        No resources to display. Please search for a resource using the search bar above.
    </div>
}
else
{
    <div class="row">

        @foreach (var r in Model)
        {
            <div class="col-md-4 mb-4">
                <div class="card shadow-sm" style="border-radius: 12px;">
                    <div class="card-body">

                        <h4 class="card-title">@r.Name</h4>

                        <p class="card-text">
                            <strong>Category:</strong> @r.Category <br />
                            <strong>Region:</strong> @r.Region <br />
                        </p>

                        <!-- Details about specific resource -->
                        <a href="@Url.Action("viewDetails", "Resources", new { id = r.Id })"
                           class="btn btn-primary w-100">
                            View Details
                        </a>

                    </div>
                </div>
            </div>
        }

    </div>


    @if (ViewBag.TotalPages != null && ViewBag.TotalPages > 1)
    {
        <nav>
            <ul class="pagination justify-content-center mt-4">

                @{
                    string keyword = ViewBag.SearchTerm;
                    string region = ViewBag.SelectedRegion;
                    bool? sortAscending = ViewBag.SortAscending;
                }

        <!-- Helper function for URL creation -->
        @functions {
            public string CreateUrl(int page, string keyword, string region, bool? asc)
            {
                var url = "/Resources/";

                if (!string.IsNullOrWhiteSpace(keyword))
                    url += $"Search?keyword={keyword}&pageNumber={page}";
                else if (!string.IsNullOrWhiteSpace(region))
                    url += $"FilterByRegion?region={region}&pageNumber={page}";
                else if (asc != null)
                    url += $"SortResources?ascending={asc}&pageNumber={page}";
                else
                    url += $"loadDashboard?pageNumber={page}";

                return url;
            }
        }

        <!-- Previous -->
        <li class="page-item @(ViewBag.PageNumber == 1 ? "disabled" : "")">
            <a class="page-link" href="@CreateUrl(ViewBag.PageNumber - 1, keyword, region, sortAscending)">Previous</a>
        </li>

        <!-- Page numbers -->
        @for (int i = 1; i <= ViewBag.TotalPages; i++)
        {
            <li class="page-item @(i == ViewBag.PageNumber ? "active" : "")">
                <a class="page-link" href="@CreateUrl(i, keyword, region, sortAscending)">@i</a>
            </li>
        }

        <!-- Next -->
        <li class="page-item @(ViewBag.PageNumber == ViewBag.TotalPages ? "disabled" : "")">
            <a class="page-link" href="@CreateUrl(ViewBag.PageNumber + 1, keyword, region, sortAscending)">Next</a>
        </li>

    </ul>
</nav>
}
}
