@model CommUnityHub.ViewModels.LoginViewModel
@{
    ViewData["Title"] = "Login";
}

<!-- Hero Header -->
<div class="py-5 text-center"
     style="background: linear-gradient(90.4deg, rgb(255, 220, 163) 21.2%, rgb(129, 255, 239) 90.7%);">
    <h1 class="fw-bold text-primary">Welcome Back</h1>
    <p class="text-dark mx-auto" style="max-width: 700px;">
        Sign in to access personalized resources and community tools.
    </p>
</div>

<!-- Login Card -->
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-6">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">

                    <h3 class="text-center fw-bold text-primary mb-4">Login</h3>

                    <form method="post">
                        <div class="mb-3">
                            <label>Email</label>
                            <input asp-for="Email" class="form-control rounded-3" placeholder="Enter your email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label>Password</label>
                            <input asp-for="Password" class="form-control rounded-3" placeholder="Enter your password" type="password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-3">
                            Login
                        </button>

                        <div class="text-center mt-3">
                            <small>
                                Don't have an account?
                                <a href="/Account/Register" class="text-primary fw-semibold">Register</a>
                            </small>
                        </div>
                    </form>

                </div>
            </div>

        </div>
    </div>
</div>
