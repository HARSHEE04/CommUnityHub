@model CommUnityHub.ViewModels.RegisterViewModel
@{
    ViewData["Title"] = "Register";
}

<!-- Hero Header -->
<div class="py-5 text-center"
     style="background: linear-gradient(90.4deg, rgb(255, 220, 163) 21.2%, rgb(129, 255, 239) 90.7%);">
    <h1 class="fw-bold text-primary">Create an Account</h1>
    <p class="text-dark mx-auto" style="max-width: 700px;">
        Join the CommUnity Hub and access support tools for families, youth, and community well-being.
    </p>
</div>

<!-- Registration Card -->
<div class="container my-5">
    <div class="row justify-content-center">
        <div class="col-md-7">

            <div class="card shadow-sm border-0 rounded-4">
                <div class="card-body p-4">

                    <h3 class="text-center fw-bold text-primary mb-4">Register</h3>

                    <form method="post">
                        <!-- Validation Summary for general errors like failed creation -->
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label>Full Name</label>
                            <input asp-for="FullName" class="form-control rounded-3" placeholder="Enter your full name" />
                            <span asp-validation-for="FullName" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label>Email</label>
                            <input asp-for="Email" class="form-control rounded-3" placeholder="Enter your email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label>Password</label>
                            <input asp-for="Password" class="form-control rounded-3" placeholder="Create a password" type="password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label>Confirm Password</label>
                            <input asp-for="ConfirmPassword" class="form-control rounded-3" placeholder="Re-enter your password" type="password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <!-- NEW: IsVolunteer Checkbox from RegisterViewModel -->
                        <div class="form-check mb-4">
                            <input class="form-check-input" type="checkbox" asp-for="IsVolunteer">
                            <label class="form-check-label" asp-for="IsVolunteer">
                                Register as a potential Volunteer (Requires Admin approval)
                            </label>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-3">
                            Create Account
                        </button>

                        <div class="text-center mt-3">
                            <small>
                                Already have an account?
                                <a href="/Account/Login" class="text-primary fw-semibold">Login</a>
                            </small>
                        </div>

                    </form>

                </div>
            </div>

        </div>
    </div>
</div>